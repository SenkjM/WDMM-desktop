<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WdmmDesktop.Pages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WdmmDesktop.Pages">

    <!-- No Background: Mica shows through -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: account list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Accounts"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Margin="14,14,14,6" />

            <ListView x:Name="AccountList"
                      Grid.Row="1"
                      SelectionChanged="AccountList_SelectionChanged"
                      Margin="8,0,8,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="2" Padding="4,6">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Url}"
                                       FontSize="11"
                                       Opacity="0.5"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Add / Delete buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="10,6,10,12">
                <Button x:Name="AddBtn"
                        Click="AddBtn_Click"
                        ToolTipService.ToolTip="Add account"
                        Padding="10,8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>
                <Button x:Name="DeleteBtn"
                        Click="DeleteBtn_Click"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Remove selected account"
                        Padding="10,8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Right: account form + sync -->
        <ScrollViewer Grid.Column="1" Padding="20,14,20,20">
            <StackPanel x:Name="FormPanel"
                        Spacing="14"
                        MaxWidth="420"
                        IsEnabled="False">

                <TextBlock x:Name="FormTitle"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="Select or add an account" />

                <StackPanel Spacing="6">
                    <TextBlock Text="Display name" FontSize="12" Opacity="0.7" />
                    <TextBox x:Name="NameBox" PlaceholderText="My NAS" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="WebDAV URL" FontSize="12" Opacity="0.7" />
                    <TextBox x:Name="UrlBox"
                             PlaceholderText="https://nas.local:5006/dav" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Username" FontSize="12" Opacity="0.7" />
                    <TextBox x:Name="UserBox" PlaceholderText="admin" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Password" FontSize="12" Opacity="0.7" />
                    <PasswordBox x:Name="PassBox" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Remote directory" FontSize="12" Opacity="0.7" />
                    <TextBox x:Name="RemoteDirBox"
                             PlaceholderText="/wdmm" />
                </StackPanel>

                <!-- Save + Sync row -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveBtn"
                            Click="SaveBtn_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="Save"
                            IsEnabled="False" />
                    <Button x:Name="SyncBtn"
                            Click="SyncBtn_Click"
                            Content="Sync Now"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Trigger wdmm_sync_trigger with these credentials" />
                </StackPanel>

                <!-- Sync result -->
                <TextBlock x:Name="SyncStatus"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <!-- Placeholder note -->
                <TextBlock FontSize="11"
                           Opacity="0.4"
                           TextWrapping="Wrap"
                           FontFamily="Cascadia Mono,Consolas,monospace"
                           Text="Account list persisted locally (%LOCALAPPDATA%\Wdmm\accounts.json).&#x0a;TODO: wdmm_account_list / wdmm_account_save not yet in FFI." />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
