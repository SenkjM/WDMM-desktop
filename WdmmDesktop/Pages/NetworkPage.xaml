<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WdmmDesktop.Pages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WdmmDesktop.Pages">

    <Grid Padding="12,10,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Source + actions -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblSource" Text="源" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="SourceCombo"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="SourceCombo_SelectionChanged" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <Button x:Name="ManageBtn" Click="ManageBtn_Click" Content="管理源…" Padding="10,6" />
                <Button x:Name="UpBtn" Click="UpBtn_Click" Content="上级" Padding="10,6" IsEnabled="False" />
                <Button x:Name="RefreshBtn" Click="RefreshBtn_Click" Content="刷新" Padding="10,6" />
                <Button x:Name="NewFolderBtn" Click="NewFolderBtn_Click" Content="新建文件夹" Padding="10,6" />
            </StackPanel>
        </Grid>

        <!-- Path -->
        <TextBlock x:Name="PathText"
                   Grid.Row="1"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="12"
                   Opacity="0.7"
                   Text="/"
                   TextWrapping="Wrap" />

        <!-- Body -->
        <Grid Grid.Row="2">
            <ListView x:Name="EntryList"
                      DoubleTapped="EntryList_DoubleTapped"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="10" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{Binding Glyph}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SizeText}"
                                       Opacity="0.55"
                                       FontSize="12"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="CtxRename" Text="重命名" Click="CtxRename_Click" />
                        <MenuFlyoutItem x:Name="CtxDelete" Text="删除" Click="CtxDelete_Click" />
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>

            <StackPanel x:Name="EmptyPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                <TextBlock x:Name="EmptyText" Text="此文件夹为空" Opacity="0.6" HorizontalAlignment="Center" />
                <Button x:Name="RetryBtn" Content="重试" Click="RefreshBtn_Click" HorizontalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>

            <ProgressRing x:Name="BusyRing" Width="36" Height="36" IsActive="False" Visibility="Collapsed"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
