<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WdmmDesktop.Pages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WdmmDesktop.Pages">

    <Grid Padding="12,10,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Source + actions -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LblSource" Text="源" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="SourceCombo"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="SourceCombo_SelectionChanged" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <Button x:Name="ManageBtn" Click="ManageBtn_Click" Content="管理源…" Padding="10,6" />
                <Button x:Name="UpBtn" Click="UpBtn_Click" Content="上级" Padding="10,6" IsEnabled="False" />
                <Button x:Name="RefreshBtn" Click="RefreshBtn_Click" Content="刷新" Padding="10,6" />
                <Button x:Name="NewFolderBtn" Click="NewFolderBtn_Click" Content="新建文件夹" Padding="10,6" />
                <Button x:Name="UploadBtn" Click="UploadBtn_Click" Content="上传…" Padding="10,6" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- Path -->
        <TextBlock x:Name="PathText"
                   Grid.Row="1"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="12"
                   Opacity="0.7"
                   Text="/"
                   TextWrapping="Wrap" />

        <!-- Multi-select batch toolbar (hidden until items selected) -->
        <StackPanel x:Name="BatchToolbar"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="Collapsed">
            <Button x:Name="SelectAllBtn" Click="SelectAllBtn_Click" Content="全选" Padding="8,5" />
            <Button x:Name="BatchDownloadBtn" Click="BatchDownloadBtn_Click" Content="下载所选" Padding="8,5" />
            <Button x:Name="BatchAddMangaBtn" Click="BatchAddMangaBtn_Click" Content="入漫画库" Padding="8,5" />
            <Button x:Name="BatchDeleteBtn" Click="BatchDeleteBtn_Click" Content="删除所选" Padding="8,5" />
            <TextBlock x:Name="SelectionCountText"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Opacity="0.6"
                       Margin="4,0,0,0" />
        </StackPanel>

        <!-- Body -->
        <Grid Grid.Row="3">
            <ListView x:Name="EntryList"
                      IsItemClickEnabled="True"
                      ItemClick="EntryList_ItemClick"
                      SelectionMode="Extended"
                      SelectionChanged="EntryList_SelectionChanged">
                <ListView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllAccelerator_Invoked" />
                </ListView.KeyboardAccelerators>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="10" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{Binding Glyph}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SizeText}"
                                       Opacity="0.55"
                                       FontSize="12"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextFlyout>
                    <MenuFlyout Opening="ContextMenu_Opening">
                        <MenuFlyoutItem x:Name="CtxDownload"  Text="下载"          Click="CtxDownload_Click" />
                        <MenuFlyoutItem x:Name="CtxViewImage" Text="查看图片"       Click="CtxViewImage_Click" />
                        <MenuFlyoutItem x:Name="CtxAddManga"  Text="添加到漫画库"   Click="CtxAddManga_Click" />
                        <MenuFlyoutItem x:Name="CtxCast"      Text="投屏"          Click="CtxCast_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="CtxRename"    Text="重命名"         Click="CtxRename_Click" />
                        <MenuFlyoutItem x:Name="CtxDelete"    Text="删除"          Click="CtxDelete_Click" />
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>

            <StackPanel x:Name="EmptyPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                <TextBlock x:Name="EmptyText" Text="此文件夹为空" Opacity="0.6" HorizontalAlignment="Center" />
                <Button x:Name="RetryBtn" Content="重试" Click="RefreshBtn_Click" HorizontalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>

            <ProgressRing x:Name="BusyRing" Width="36" Height="36" IsActive="False" Visibility="Collapsed"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Status / action feedback -->
        <TextBlock x:Name="ActionStatus"
                   Grid.Row="4"
                   FontSize="11"
                   Opacity="0.55"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Page>
