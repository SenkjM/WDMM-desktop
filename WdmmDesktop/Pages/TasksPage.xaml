<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WdmmDesktop.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WdmmDesktop.Pages">

    <!-- No Background: Mica shows through -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: pending count + refresh -->
        <Grid Grid.Row="0" Margin="14,12,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE896;" FontSize="16" Opacity="0.6" />
                <TextBlock Text="Tasks / Queue"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Border x:Name="PendingBadge"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="10"
                        Padding="7,1"
                        Visibility="Collapsed">
                    <TextBlock x:Name="PendingCount"
                               FontSize="11"
                               Foreground="White"
                               FontWeight="SemiBold" />
                </Border>
            </StackPanel>

            <Button x:Name="RefreshBtn"
                    Grid.Column="1"
                    Click="RefreshBtn_Click"
                    ToolTipService.ToolTip="Refresh queue"
                    Padding="10,8">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Task list -->
        <ListView x:Name="TaskList"
                  Grid.Row="1"
                  Margin="12,0,12,0"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Path + kind + status -->
                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RemotePath}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Kind}"
                                           FontSize="11"
                                           Opacity="0.5"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StatusDisplay}"
                                           FontSize="11"
                                           Opacity="0.7" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Cancel button (always shown; handler checks CanCancel) -->
                        <Button Grid.Column="1"
                                Click="CancelBtn_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Cancel task"
                                Padding="8,6">
                            <FontIcon Glyph="&#xE711;" FontSize="13" Opacity="0.7" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
            <FontIcon Glyph="&#xE73E;" FontSize="40" Opacity="0.3" />
            <TextBlock Text="No tasks in queue"
                       FontSize="13"
                       Opacity="0.5"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Status bar -->
        <TextBlock x:Name="StatusBar"
                   Grid.Row="2"
                   Margin="14,4,14,10"
                   FontSize="11"
                   Opacity="0.45" />
    </Grid>
</Page>
