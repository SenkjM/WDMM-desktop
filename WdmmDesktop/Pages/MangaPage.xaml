<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WdmmDesktop.Pages.MangaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WdmmDesktop.Pages">

    <!-- No Background: Mica shows through -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="12,10,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Manga Library"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <Button x:Name="RefreshBtn"
                    Grid.Column="1"
                    Click="RefreshBtn_Click"
                    ToolTipService.ToolTip="Refresh library"
                    Padding="10,8">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Series grid — GridView wraps natively; no Community Toolkit WrapPanel needed -->
        <GridView x:Name="SeriesGrid"
                  Grid.Row="1"
                  Margin="8,0,8,0"
                  IsItemClickEnabled="True"
                  ItemClick="SeriesGrid_ItemClick"
                  SelectionMode="None">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Border Width="130"
                            Height="190"
                            CornerRadius="6"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <StackPanel VerticalAlignment="Bottom" Padding="8,6" Spacing="2">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SubLine}"
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ProgressHint}"
                                       FontSize="10"
                                       Opacity="0.4"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Empty state (hidden when items present) -->
        <StackPanel x:Name="EmptyState"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
            <FontIcon Glyph="&#xE736;" FontSize="40" Opacity="0.3" />
            <TextBlock x:Name="EmptyText"
                       FontSize="13"
                       Opacity="0.5"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Status bar -->
        <TextBlock x:Name="StatusBar"
                   Grid.Row="2"
                   Margin="14,4,14,10"
                   FontSize="11"
                   Opacity="0.45" />
    </Grid>
</Page>
