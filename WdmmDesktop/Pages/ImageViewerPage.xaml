<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WdmmDesktop.Pages.ImageViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WdmmDesktop.Pages">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Padding="12,8,12,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackBtn" Click="BackBtn_Click" Padding="10,6" ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <TextBlock x:Name="TitleText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis"
                       Opacity="0.85" />
            <TextBlock x:Name="IndexText"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Opacity="0.5" />
        </Grid>

        <!-- Image area -->
        <Grid Grid.Row="1">
            <!-- Image inside ScrollViewer for basic pan/zoom (touch/wheel) -->
            <ScrollViewer x:Name="ImageScroll"
                          ZoomMode="Enabled"
                          MinZoomFactor="0.1"
                          MaxZoomFactor="8"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Auto"
                          VerticalScrollMode="Auto">
                <Image x:Name="MainImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            </ScrollViewer>

            <!-- Prev / Next overlays -->
            <Button x:Name="PrevBtn"
                    Click="PrevBtn_Click"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0"
                    Padding="10,14"
                    Opacity="0.7">
                <FontIcon Glyph="&#xE76B;" FontSize="16" />
            </Button>
            <Button x:Name="NextBtn"
                    Click="NextBtn_Click"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Padding="10,14"
                    Opacity="0.7">
                <FontIcon Glyph="&#xE76C;" FontSize="16" />
            </Button>

            <!-- Error / loading state -->
            <StackPanel x:Name="StatusPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="Collapsed">
                <ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText"
                           FontSize="13"
                           Opacity="0.55"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="340"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Bottom filename hint -->
        <TextBlock x:Name="PathHint"
                   Grid.Row="2"
                   Margin="14,4,14,8"
                   FontSize="11"
                   Opacity="0.4"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Page>
