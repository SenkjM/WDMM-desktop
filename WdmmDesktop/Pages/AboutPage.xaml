<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WdmmDesktop.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WdmmDesktop.Pages">

    <!-- No Background: Mica shows through -->
    <ScrollViewer Padding="32,24,32,32">
        <StackPanel Spacing="24" MaxWidth="520">

            <!-- App header -->
            <StackPanel Spacing="6">
                <FontIcon Glyph="&#xE946;" FontSize="40" Opacity="0.6" />
                <TextBlock Text="WDMM"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock x:Name="VersionText"
                           FontSize="13"
                           Opacity="0.6" />
            </StackPanel>

            <!-- Core FFI status -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Core FFI"
                               FontWeight="SemiBold"
                               FontSize="13" />
                    <TextBlock x:Name="FfiDetailText"
                               FontSize="12"
                               Opacity="0.8"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="ApiStatusText"
                                   FontSize="12"
                                   Opacity="0.8" />
                        <TextBlock x:Name="ApiPortText"
                                   FontSize="12"
                                   Opacity="0.5" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Parity matrix -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Android Parity Matrix"
                               FontWeight="SemiBold"
                               FontSize="13" />
                    <TextBlock x:Name="ParityText"
                               FontSize="11"
                               Opacity="0.8"
                               TextWrapping="Wrap"
                               FontFamily="Cascadia Mono,Consolas,monospace"
                               LineHeight="20" />
                </StackPanel>
            </Border>

            <!-- Notes -->
            <TextBlock FontSize="11"
                       Opacity="0.4"
                       TextWrapping="Wrap"
                       Text="wdmm_ffi.dll required at runtime (Windows). Missing DLL is silently tolerated — status strip and Settings Save become no-ops." />

        </StackPanel>
    </ScrollViewer>
</Page>
