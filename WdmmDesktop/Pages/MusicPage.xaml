<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WdmmDesktop.Pages.MusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WdmmDesktop.Pages">

    <!-- No Background: Mica shows through -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search bar + refresh -->
        <Grid Grid.Row="0" Margin="12,10,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="0"
                            PlaceholderText="Search tracks…"
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged"
                            QuerySubmitted="SearchBox_QuerySubmitted" />
            <Button x:Name="RefreshBtn"
                    Grid.Column="1"
                    Click="RefreshBtn_Click"
                    ToolTipService.ToolTip="Reload from library"
                    Margin="8,0,0,0"
                    Padding="10,8">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Track list -->
        <ListView x:Name="TrackList"
                  Grid.Row="1"
                  Margin="12,0,12,0"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Title + sub-line -->
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SubLine}"
                                       FontSize="11"
                                       Opacity="0.55"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Duration -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DurationDisplay}"
                                   FontSize="11"
                                   Opacity="0.5"
                                   VerticalAlignment="Center"
                                   FontFamily="Cascadia Mono,Consolas,monospace" />

                        <!-- Cast button: Tag="{Binding}" passes TrackItem to click handler -->
                        <Button Grid.Column="2"
                                Click="CastBtn_Click"
                                Tag="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Cast to DLNA renderer"
                                Padding="8,6">
                            <FontIcon Glyph="&#xE93E;" FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty / error state -->
        <StackPanel x:Name="EmptyState"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="Collapsed">
            <FontIcon Glyph="&#xE8D6;" FontSize="40" Opacity="0.3" />
            <TextBlock x:Name="EmptyText"
                       FontSize="13"
                       Opacity="0.5"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Status bar -->
        <TextBlock x:Name="StatusBar"
                   Grid.Row="2"
                   Margin="14,4,14,10"
                   FontSize="11"
                   Opacity="0.45" />
    </Grid>
</Page>
