<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WdmmDesktop.Pages.FoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WdmmDesktop.Pages">

    <!-- No Background: Mica shows through -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Path bar -->
        <Grid Grid.Row="0" Margin="12,10,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="UpBtn"
                    Grid.Column="0"
                    Click="UpBtn_Click"
                    IsEnabled="False"
                    ToolTipService.ToolTip="Go to parent folder"
                    Margin="0,0,6,0"
                    Padding="10,8">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>

            <TextBox x:Name="PathBox"
                     Grid.Column="1"
                     PlaceholderText="Enter a path or click Browse…"
                     VerticalAlignment="Center"
                     KeyDown="PathBox_KeyDown" />

            <Button x:Name="BrowseBtn"
                    Grid.Column="2"
                    Content="Browse…"
                    Click="BrowseBtn_Click"
                    Margin="6,0,0,0"
                    Padding="12,8" />
        </Grid>

        <!-- File/folder list -->
        <ListView x:Name="ItemsList"
                  Grid.Row="1"
                  Margin="12,0,12,0"
                  SelectionMode="Single"
                  DoubleTapped="ItemsList_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="{Binding IconGlyph}"
                                  FontSize="16"
                                  Opacity="0.7" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Meta}"
                                   FontSize="11"
                                   Opacity="0.5"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- WebDAV stub note -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="12,8"
                Margin="12,4,12,12"
                CornerRadius="6">
            <TextBlock FontSize="11"
                       Opacity="0.5"
                       TextWrapping="Wrap"
                       FontFamily="Cascadia Mono,Consolas,monospace"
                       Text="Remote WebDAV browse: TODO — wdmm_webdav_list not yet in FFI. Configure accounts on Network page, then Sync to pull files locally." />
        </Border>
    </Grid>
</Page>
