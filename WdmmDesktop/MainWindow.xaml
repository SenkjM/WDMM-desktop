<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WdmmDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WdmmDesktop">

    <!-- Mica (BaseAlt) fills the entire window; do NOT set Background on any root container -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <!-- Two rows: custom title bar strip + shell body. No Background here. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TITLE BAR: drag region; icon + product name; caption buttons overlay the right end -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        IsHitTestVisible="False">
                <FontIcon Glyph="&#xE93C;"
                          FontSize="18"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />
                <TextBlock Text="WDMM"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- SHELL BODY: sidebar | content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- SidebarColumn width toggled in code between 220 and 52 -->
                <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR PANEL -->
            <Grid x:Name="SidebarPanel" Grid.Column="0" ClipToBounds="True">

                <!-- Right-edge 1-dp divider; not hit-testable -->
                <Rectangle Width="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Stretch"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                           IsHitTestVisible="False" />

                <!-- Inner content, inset 1 dp from the divider -->
                <Grid Margin="0,0,1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toggle row: CollapseBtn visible when expanded, ExpandBtn when collapsed -->
                    <Grid Grid.Row="0" Height="44" Margin="6,4,6,0">
                        <Button x:Name="ExpandBtn"
                                Click="ToggleSidebar_Click"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Expand sidebar"
                                Padding="10,8">
                            <FontIcon Glyph="&#xE76C;" FontSize="16" />
                        </Button>
                        <Button x:Name="CollapseBtn"
                                Click="ToggleSidebar_Click"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="Collapse sidebar"
                                Padding="10,8">
                            <FontIcon Glyph="&#xE76B;" FontSize="16" />
                        </Button>
                    </Grid>

                    <!-- NAV DESTINATIONS -->
                    <StackPanel Grid.Row="1"
                                x:Name="NavItemsPanel"
                                Spacing="2"
                                Margin="6,4,6,4">

                        <RadioButton x:Name="NavFolders"
                                     GroupName="ShellNav"
                                     Tag="Folders"
                                     Checked="NavItem_Checked"
                                     Style="{StaticResource NavItemStyle}"
                                     IsChecked="True">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                <TextBlock x:Name="LblFolders" Text="Folders" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavMusicLibrary"
                                     GroupName="ShellNav"
                                     Tag="Music Library"
                                     Checked="NavItem_Checked"
                                     Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8D6;" FontSize="16" />
                                <TextBlock x:Name="LblMusicLibrary" Text="Music Library" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavPlaylists"
                                     GroupName="ShellNav"
                                     Tag="Playlists"
                                     Checked="NavItem_Checked"
                                     Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE762;" FontSize="16" />
                                <TextBlock x:Name="LblPlaylists" Text="Playlists" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavManga"
                                     GroupName="ShellNav"
                                     Tag="Manga"
                                     Checked="NavItem_Checked"
                                     Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE82D;" FontSize="16" />
                                <TextBlock x:Name="LblManga" Text="Manga" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavNetworkLibrary"
                                     GroupName="ShellNav"
                                     Tag="Network Library"
                                     Checked="NavItem_Checked"
                                     Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE968;" FontSize="16" />
                                <TextBlock x:Name="LblNetworkLibrary" Text="Network Library" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavTasks"
                                     GroupName="ShellNav"
                                     Tag="Tasks"
                                     Checked="NavItem_Checked"
                                     Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE896;" FontSize="16" />
                                <TextBlock x:Name="LblTasks" Text="Tasks" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavAbout"
                                     GroupName="ShellNav"
                                     Tag="About"
                                     Checked="NavItem_Checked"
                                     Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE946;" FontSize="16" />
                                <TextBlock x:Name="LblAbout" Text="About" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>

                    <!-- FFI status strip -->
                    <TextBlock x:Name="FfiStatusStrip"
                               Grid.Row="2"
                               Margin="12,4,12,4"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Opacity="0.55"
                               ToolTipService.ToolTip="{Binding Text, ElementName=FfiStatusStrip}" />

                    <!-- Settings button: pane bottom, opens modal dialog -->
                    <Button x:Name="SettingsBtn"
                            Grid.Row="3"
                            Click="SettingsBtn_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="6,2,6,10"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock x:Name="LblSettings" Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                </Grid>
            </Grid>

            <!-- CONTENT FRAME -->
            <Frame x:Name="ContentFrame"
                   Grid.Column="1"
                   IsTabStop="False" />

        </Grid>
    </Grid>
</Window>
