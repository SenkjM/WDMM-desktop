<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WdmmDesktop.Dialogs.DmrInfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WdmmDesktop.Dialogs"
    Title="Renderer Info"
    PrimaryButtonText="Save"
    CloseButtonText="Close"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <AcrylicBrush x:Key="DialogAcrylicBrush"
                      TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                      TintOpacity="0.65"
                      FallbackColor="{ThemeResource SolidBackgroundFillColorBase}" />
    </ContentDialog.Resources>

    <Border Background="{StaticResource DialogAcrylicBrush}"
            CornerRadius="8"
            Padding="4">
        <StackPanel Spacing="14" Width="400">

            <StackPanel Spacing="4">
                <TextBlock Text="Discovered name" FontSize="11" Opacity="0.55" FontWeight="SemiBold" />
                <TextBlock x:Name="FriendlyNameText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Override display name" FontSize="11" Opacity="0.55" FontWeight="SemiBold" />
                <TextBox x:Name="OverrideNameBox" PlaceholderText="Leave empty to use discovered name" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="USN (Unique Service Name)" FontSize="11" Opacity="0.55" FontWeight="SemiBold" />
                <TextBox x:Name="UsnText" IsReadOnly="True"
                         FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Description URL (Location)" FontSize="11" Opacity="0.55" FontWeight="SemiBold" />
                <TextBox x:Name="LocationText" IsReadOnly="True" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="AVTransport Control URL" FontSize="11" Opacity="0.55" FontWeight="SemiBold" />
                <TextBox x:Name="AvTransportText" IsReadOnly="True" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="10,8">
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="ForceDirectToggle" Header="Force direct (off = HLS)"
                                  MinWidth="0" Toggled="ForceDirectToggle_Toggled" />
                    <TextBlock x:Name="CompatText" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock FontSize="10" Opacity="0.4" TextWrapping="Wrap"
                               FontFamily="Cascadia Mono,Consolas,monospace"
                               Text="Prefs keyed by USN in Core dmr_prefs.db (wdmm_dmr_prefs_*)." />
                    <TextBlock x:Name="SaveErrorText" FontSize="11" Visibility="Collapsed"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</ContentDialog>
