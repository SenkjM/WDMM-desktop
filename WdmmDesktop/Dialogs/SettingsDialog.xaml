<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WdmmDesktop.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WdmmDesktop.Dialogs"
    Title="设置"
    CloseButtonText="关闭"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <AcrylicBrush x:Key="DialogAcrylicBrush"
                      TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                      TintOpacity="0.65"
                      FallbackColor="{ThemeResource SolidBackgroundFillColorBase}" />
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin"     Value="0,0,0,6" />
        </Style>
        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"  Value="11" />
            <Setter Property="Opacity"   Value="0.55" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StubRowStyle" TargetType="StackPanel">
            <Setter Property="Spacing" Value="4" />
        </Style>
    </ContentDialog.Resources>

    <Border Background="{StaticResource DialogAcrylicBrush}"
            CornerRadius="8"
            Padding="0">
        <Grid Width="680" Height="480">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left nav list -->
            <Border Grid.Column="0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="6,8,6,8" Spacing="2">
                    <!-- FFI version strip at top -->
                    <TextBlock x:Name="FfiVersionText"
                               FontSize="11"
                               Opacity="0.5"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,2,8,10" />

                    <RadioButton x:Name="NavHome"      GroupName="SettingsNav" Tag="Home"     IsChecked="True" Checked="SettingsNav_Checked" HorizontalAlignment="Stretch" Content="主页与导航" />
                    <RadioButton x:Name="NavLibrary"   GroupName="SettingsNav" Tag="Library"               Checked="SettingsNav_Checked" HorizontalAlignment="Stretch" Content="媒体库" />
                    <RadioButton x:Name="NavNetwork2"  GroupName="SettingsNav" Tag="Network2"               Checked="SettingsNav_Checked" HorizontalAlignment="Stretch" Content="文件源" />
                    <RadioButton x:Name="NavVideoFile" GroupName="SettingsNav" Tag="VideoFile"              Checked="SettingsNav_Checked" HorizontalAlignment="Stretch" Content="视频/图片/文件" />
                    <RadioButton x:Name="NavMisc"      GroupName="SettingsNav" Tag="Misc"                  Checked="SettingsNav_Checked" HorizontalAlignment="Stretch" Content="杂项" />
                    <RadioButton x:Name="NavSync"      GroupName="SettingsNav" Tag="Sync"                  Checked="SettingsNav_Checked" HorizontalAlignment="Stretch" Content="同步与备份" />
                    <RadioButton x:Name="NavOpenApi"   GroupName="SettingsNav" Tag="OpenApi"               Checked="SettingsNav_Checked" HorizontalAlignment="Stretch" Content="第三方/开发者" />
                </StackPanel>
            </Border>

            <!-- Right content area -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,16,20,16">
                <Grid>

                    <!-- ── Section 1: 主页与导航 ── -->
                    <StackPanel x:Name="PanelHome" Spacing="16" Visibility="Visible">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="主页与导航" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="默认首页" FontSize="12" />
                            <ComboBox x:Name="DefaultHomeCombo"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Folders (我的文件夹)" Tag="Folders" IsSelected="True" />
                                <ComboBoxItem Content="Music"               Tag="Music" />
                                <ComboBoxItem Content="Playlists"           Tag="Playlists" />
                                <ComboBoxItem Content="Manga"               Tag="Manga" />
                                <ComboBoxItem Content="Network"             Tag="Network" />
                                <ComboBoxItem Content="Tasks"               Tag="Tasks" />
                            </ComboBox>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="应用启动时进入的页面。" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <ToggleSwitch x:Name="RememberNetworkPathToggle"
                                          Header="记住网络路径"
                                          MinWidth="0" />
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="切换至网络页时自动恢复上次浏览的路径（本地偏好）。" />
                        </StackPanel>

                        <Button x:Name="SaveHomeBtn"
                                Click="SaveHomeBtn_Click"
                                Content="保存"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,8" />
                        <TextBlock x:Name="HomeStatusText" FontSize="11" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- ── Section 2: 媒体库 ── -->
                    <StackPanel x:Name="PanelLibrary" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="媒体库" />
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Title="KV-backed (Wave C)"
                                 Message="以下设置通过 wdmm_kv_* 写入 Core KV，重启后生效。媒体库读写本身仍走 wdmm_track_list / wdmm_library_init。" />

                        <StackPanel Spacing="10">
                            <TextBlock Text="扫描选项" FontSize="12" FontWeight="SemiBold" />
                            <ToggleSwitch x:Name="ScanRecursiveToggle"
                                          Header="递归扫描子目录"
                                          MinWidth="0" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="最大扫描深度" FontSize="12" />
                                <NumberBox x:Name="ScanDepthBox"
                                           Minimum="1" Maximum="32" Value="5"
                                           SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="媒体类型" FontSize="12" FontWeight="SemiBold" />
                            <ToggleSwitch x:Name="ScanAudioToggle"
                                          Header="扫描音频文件"
                                          MinWidth="0" />
                            <ToggleSwitch x:Name="ScanVideoToggle"
                                          Header="扫描视频文件"
                                          MinWidth="0" />
                            <ToggleSwitch x:Name="ScanMangaToggle"
                                          Header="扫描漫画/图片"
                                          MinWidth="0" />
                        </StackPanel>

                        <Button x:Name="SaveLibraryBtn"
                                Click="SaveLibraryBtn_Click"
                                Content="保存"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,8" />
                        <TextBlock x:Name="LibraryStatusText" FontSize="11" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- ── Section 3: 网络库 ── -->
                    <StackPanel x:Name="PanelNetwork2" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="文件源" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="账号" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="源列表在「文件源」页管理；此处仅展示数量。" />
                            <TextBlock x:Name="AccountCountText" FontSize="12" Opacity="0.7" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="下载队列设置" FontSize="12" FontWeight="SemiBold" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="最大并发数" FontSize="12" />
                                <NumberBox x:Name="QueueConcurrencyBox"
                                           Minimum="1" Maximum="8" Value="1"
                                           SpinButtonPlacementMode="Compact"
                                           SmallChange="1" LargeChange="1"
                                           ValueChanged="QueueConcurrencyBox_ValueChanged" />
                            </StackPanel>
                            <TextBlock x:Name="QueueConcurrencyStatusText"
                                       Style="{StaticResource HintTextStyle}"
                                       Text="通过 wdmm_queue_get/set_concurrency（Core Wave D）设置；范围 1–8。" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="传输加密" FontSize="12" FontWeight="SemiBold" />
                            <ToggleSwitch x:Name="CryptSequentialDownloadToggle"
                                          Header="顺序下载加密（AES-256-GCM）"
                                          MinWidth="0" />
                            <ToggleSwitch x:Name="PreferLibsodiumToggle"
                                          Header="优先使用 libsodium secretbox"
                                          MinWidth="0" />
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="分片下载" FontSize="12" FontWeight="SemiBold" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="分片大小（字节，0 = 禁用）" FontSize="12" />
                                <TextBox x:Name="DownloadPartSizeBox"
                                         PlaceholderText="例如 10485760" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="分片数量（0 = 禁用）" FontSize="12" />
                                <TextBox x:Name="DownloadPartCountBox"
                                         PlaceholderText="例如 4" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="DLNA 投屏" FontSize="12" FontWeight="SemiBold" />
                            <ToggleSwitch x:Name="DlnaRemuxToggle"
                                          Header="启用 DLNA remux（直接复用）"
                                          MinWidth="0" />
                            <ToggleSwitch x:Name="DlnaTranscodeToggle"
                                          Header="启用 DLNA 转码"
                                          MinWidth="0" />
                        </StackPanel>

                        <Button x:Name="SaveNetwork2Btn"
                                Click="SaveNetwork2Btn_Click"
                                Content="保存"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,8" />
                        <TextBlock x:Name="Network2StatusText" FontSize="11" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- ── Section 4: 视频/图片/文件类型 ── -->
                    <StackPanel x:Name="PanelVideoFile" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="视频 / 图片 / 文件类型" />
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Title="KV-backed (Wave C)"
                                 Message="file_type_config_json 通过 wdmm_kv_* 写入 Core KV；其他文件类型偏好仍待 wdmm_prefs_* FFI。" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="文件类型配置 (JSON)" FontSize="12" FontWeight="SemiBold" />
                            <TextBox x:Name="FileTypeConfigBox"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="80"
                                     PlaceholderText='例如 {"video":["mp4","mkv"],"audio":["flac","mp3"]}'
                                     FontFamily="Cascadia Mono,Consolas,monospace"
                                     FontSize="11" />
                        </StackPanel>
                        <Button x:Name="SaveVideoFileBtn"
                                Click="SaveVideoFileBtn_Click"
                                Content="保存"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,8" />
                        <TextBlock x:Name="VideoFileStatusText" FontSize="11" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- ── Section 5: 杂项 ── -->
                    <StackPanel x:Name="PanelMisc" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="杂项" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="主题" FontSize="12" FontWeight="SemiBold" />
                            <ComboBox x:Name="ThemeCombo"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="跟随系统" Tag="Default"  IsSelected="True" />
                                <ComboBoxItem Content="浅色"     Tag="Light" />
                                <ComboBoxItem Content="深色"     Tag="Dark" />
                            </ComboBox>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="更改主题立即生效（WinUI ElementTheme）。" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="界面语言" FontSize="12" FontWeight="SemiBold" />
                            <ComboBox x:Name="LocaleCombo"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="跟随系统" Tag="system" IsSelected="True" />
                                <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                                <ComboBoxItem Content="English"  Tag="en" />
                            </ComboBox>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="app_locale 通过 wdmm_kv_* 持久化。" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="提示持续时间（秒）" FontSize="12" FontWeight="SemiBold" />
                            <NumberBox x:Name="SnackDurationBox"
                                       Minimum="1" Maximum="30" Value="3"
                                       SpinButtonPlacementMode="Compact" />
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="snack_duration 通过 wdmm_kv_* 持久化。" />
                        </StackPanel>

                        <Button x:Name="SaveMiscBtn"
                                Click="SaveMiscBtn_Click"
                                Content="应用"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="16,8" />
                        <TextBlock x:Name="MiscStatusText" FontSize="11" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- ── Section 6: 同步与备份 ── -->
                    <StackPanel x:Name="PanelSync" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="同步与备份" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="源" FontSize="12" FontWeight="SemiBold" />
                            <ComboBox x:Name="SyncSourceCombo" HorizontalAlignment="Stretch" />
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="源在「文件源」页管理；同步使用该源的 WebDAV 凭据。" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="远端路径" FontSize="12" FontWeight="SemiBold" />
                            <TextBox x:Name="SyncRemoteDirBox"
                                     PlaceholderText="/wdmm-sync" />
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="凭证、歌单与音乐库共用此远端路径（对齐安卓同步与备份）。" />
                        </StackPanel>

                        <Button x:Name="TriggerSyncBtn"
                                Click="TriggerSyncBtn_Click"
                                Content="立即同步"
                                Padding="16,8" />
                        <TextBlock x:Name="SyncStatusText" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- ── Section 7: 第三方/开发者 (OpenAPI) ── -->
                    <StackPanel x:Name="PanelOpenApi" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="第三方 / 开发者 (OpenAPI)" />
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Text="OpenAPI 服务器仅供第三方 HTTP 客户端使用（如脚本、外部工具）。桌面应用内部业务路径使用 FFI，不依赖此服务器。" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="绑定模式" FontSize="12" FontWeight="SemiBold" />
                            <ComboBox x:Name="BindModeCombo"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Local (127.0.0.1)" />
                                <ComboBoxItem Content="Global (0.0.0.0)" />
                                <ComboBoxItem Content="Custom" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="端口" FontSize="12" FontWeight="SemiBold" />
                            <TextBox x:Name="PortBox"
                                     Text="8080"
                                     PlaceholderText="1024-65535"
                                     InputScope="Number"
                                     MaxLength="5" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="API Token（只读）" FontSize="12" FontWeight="SemiBold" />
                            <TextBox x:Name="TokenBox"
                                     IsReadOnly="True"
                                     FontFamily="Cascadia Mono,Consolas,monospace"
                                     FontSize="11" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="StartApiBtn"
                                        Content="启动服务器"
                                        Click="StartApiBtn_Click"
                                        Padding="12,6" />
                                <Button x:Name="StopApiBtn"
                                        Content="停止服务器"
                                        Click="StopApiBtn_Click"
                                        Padding="12,6" />
                                <Button x:Name="RotateTokenBtn"
                                        Content="轮换 Token"
                                        Click="RotateTokenBtn_Click"
                                        Padding="12,6" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="本机 FFI 客户端不需要 Token；外部 HTTP 客户端须在 Authorization 头携带它。" />
                        </StackPanel>

                        <TextBlock x:Name="SaveStatusText"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</ContentDialog>
