<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WdmmDesktop.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WdmmDesktop.Dialogs"
    Title="Settings"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <!-- Acrylic tint for the dialog content panel -->
        <AcrylicBrush x:Key="DialogAcrylicBrush"
                      TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                      TintOpacity="0.65"
                      FallbackColor="{ThemeResource SolidBackgroundFillColorBase}" />
    </ContentDialog.Resources>

    <Border Background="{StaticResource DialogAcrylicBrush}"
            CornerRadius="8"
            Padding="4">
        <StackPanel Spacing="16" Width="360">

            <!-- FFI status row -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="6"
                    Padding="12,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9F5;" FontSize="14" />
                    <TextBlock x:Name="FfiVersionText"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Bind Mode -->
            <StackPanel Spacing="6">
                <TextBlock Text="Bind Mode" FontWeight="SemiBold" FontSize="13" />
                <ComboBox x:Name="BindModeCombo"
                          SelectedIndex="0"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Local (127.0.0.1)" />
                    <ComboBoxItem Content="Global (0.0.0.0)" />
                    <ComboBoxItem Content="Custom" />
                </ComboBox>
            </StackPanel>

            <!-- Port -->
            <StackPanel Spacing="6">
                <TextBlock Text="Port" FontWeight="SemiBold" FontSize="13" />
                <TextBox x:Name="PortBox"
                         Text="8080"
                         PlaceholderText="1024-65535"
                         InputScope="Number"
                         MaxLength="5" />
            </StackPanel>

            <!-- Token (read-only) -->
            <StackPanel Spacing="6">
                <TextBlock Text="API Token" FontWeight="SemiBold" FontSize="13" />
                <TextBox x:Name="TokenBox"
                         Text=""
                         IsReadOnly="True"
                         FontFamily="Cascadia Mono,Consolas,monospace"
                         FontSize="12" />
                <TextBlock Text="Native FFI clients on the same machine skip this token. External HTTP clients must include it in the Authorization header."
                           FontSize="11"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Save status / error feedback -->
            <TextBlock x:Name="SaveStatusText"
                       FontSize="12"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

        </StackPanel>
    </Border>
</ContentDialog>
