<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WdmmDesktop.Dialogs.CastDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WdmmDesktop.Dialogs"
    Title="Cast to renderer"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <AcrylicBrush x:Key="DialogAcrylicBrush"
                      TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                      TintOpacity="0.65"
                      FallbackColor="{ThemeResource SolidBackgroundFillColorBase}" />
    </ContentDialog.Resources>

    <Border Background="{StaticResource DialogAcrylicBrush}"
            CornerRadius="8"
            Padding="6">
        <Grid Width="460" MinHeight="320">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Source row -->
            <Grid Grid.Row="0" Margin="2,2,2,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Source:"
                           FontSize="13"
                           Opacity="0.7"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox x:Name="SourceBox"
                         Grid.Column="1"
                         PlaceholderText="Local file path to cast"
                         VerticalAlignment="Center" />
            </Grid>

            <!-- Pending track badge -->
            <Border x:Name="PendingTrackBadge"
                    Grid.Row="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="6"
                    Padding="10,6"
                    Margin="0,0,0,6"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8D6;" FontSize="14" Opacity="0.7" />
                    <TextBlock x:Name="PendingTrackText"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="ClearPendingBtn"
                            Click="ClearPendingBtn_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4,2">
                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- DMR list -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Discover row -->
                <Grid Grid.Row="0" Margin="2,0,2,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Renderers"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="DiscoverProgress"
                                      Width="18" Height="18"
                                      IsActive="False"
                                      Visibility="Collapsed" />
                        <Button x:Name="DiscoverBtn"
                                Click="DiscoverBtn_Click"
                                Content="Discover"
                                Padding="12,8" />
                    </StackPanel>
                </Grid>

                <ListView x:Name="DmrList"
                          Grid.Row="1"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,2">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FriendlyName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Usn}"
                                                       FontSize="10"
                                                       Opacity="0.45"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontFamily="Cascadia Mono,Consolas,monospace" />
                                        </StackPanel>

                                        <ToggleButton Grid.Column="1"
                                                      Click="CompatToggle_Click"
                                                      ToolTipService.ToolTip="Direct stream (toggle for HLS transcode)"
                                                      FontSize="11"
                                                      Padding="8,6"
                                                      Content="Direct" />

                                        <Button Grid.Column="2"
                                                Click="InfoBtn_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="Renderer info"
                                                Padding="8,6">
                                            <FontIcon Glyph="&#xE946;" FontSize="14" />
                                        </Button>

                                        <Button Grid.Column="3"
                                                Click="CastBtn_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                ToolTipService.ToolTip="Cast to this renderer"
                                                Padding="12,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE93E;" FontSize="13" />
                                                <TextBlock Text="Cast" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState"
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <FontIcon Glyph="&#xE93E;" FontSize="40" Opacity="0.25" />
                    <TextBlock x:Name="EmptyText"
                               Text="Press Discover to find DLNA renderers on the local network."
                               FontSize="13"
                               Opacity="0.5"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="280"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Status -->
            <StackPanel Grid.Row="3" Margin="2,4,2,2" Spacing="2">
                <TextBlock x:Name="CastStatus"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <TextBlock FontSize="10"
                           Opacity="0.35"
                           TextWrapping="Wrap"
                           FontFamily="Cascadia Mono,Consolas,monospace"
                           Text="Cast rule: DLNA→proxy only. Single-file mutex. No auto HLS↔direct fallback. USN-keyed prefs." />
            </StackPanel>
        </Grid>
    </Border>
</ContentDialog>
