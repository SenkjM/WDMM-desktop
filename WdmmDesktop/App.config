<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!--
        probing privatePath: instructs the assembly loader to also search
        bin\lib\ for managed assemblies.

        .NET 8 self-contained apps resolve framework and WinAppSDK assemblies
        via deps.json (all currently at bin\ root); this entry is therefore a
        no-op for those assemblies.  It is included to enable future managed
        assemblies placed in bin\lib\ to be found without further code changes.

        Native DLL loading (wdmm_ffi.dll) is handled separately by the
        SetDllDirectoryW("lib") call in App.xaml.cs — assembly probing
        does not affect Win32 DLL resolution.
      -->
      <probing privatePath="lib" />
    </assemblyBinding>
  </runtime>
</configuration>
